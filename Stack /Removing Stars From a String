class Solution {
    public String removeStars(String s) {
        char[] stack = new char[s.length()];
        int index = 0;

        for (int i = 0; i < s.length(); i++) {
            char current = s.charAt(i);

            if (current == '*') {
                index--;
            } else {
                stack[index] = current;
                index++;
            }
        }

        return new String(stack, 0, index);
    }
}
